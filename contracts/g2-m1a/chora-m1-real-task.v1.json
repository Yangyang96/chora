  },
  "requirement": {
    "statement": "An acceptance criterion must explain what its title means; blank or whitespace-only descriptions are rejected.",
    "constraints": [
      "Preserve existing valid acceptance criterion behavior.",
      "Do not change persistence, Public API, UI, Runtime, or Sandbox code.",
      "Return a reviewable patch limited to the declared files."
    ]
  },
  "spec": {
    "desired_behavior": [
      "NewAcceptanceCriterion accepts a non-blank title and description.",
      "NewAcceptanceCriterion rejects an empty or whitespace-only description.",
      "Task construction and existing Domain tests remain green."
    ],
    "out_of_scope": [
      "Editing existing persisted criteria.",
      "Changing acceptance criterion IDs or serialization.",
      "Adding a generalized validation framework."
    ]
  },
  "acceptance": {
    "criteria": [
      {
        "id": "criterion_018f0c4a-1a2d-7c3d-8e4f-1234567890ab",
        "title": "Blank descriptions fail closed",
        "description": "Empty and whitespace-only descriptions return domain.ErrInvalidArgument.",
        "verification": "go test ./internal/domain -run 'TestNewAcceptanceCriterion'"
      },
      {
        "id": "criterion_018f0c4a-1a2e-7c3d-8e4f-1234567890ab",
        "title": "Valid criteria remain stable",
        "description": "A valid title and description are retained without unrelated behavior changes.",
        "verification": "go test ./internal/domain"
      }
    ]
  },
  "technical_plan": {
    "summary": "Tighten the existing AcceptanceCriterion constructor and add focused regression coverage.",
    "steps": [
      {
        "id": "plan-1",
        "description": "Add focused constructor tests for valid, empty, and whitespace-only descriptions.",
        "files": ["internal/domain/task_test.go"]
      },
      {
        "id": "plan-2",
        "description": "Require a trimmed non-empty description in NewAcceptanceCriterion.",
        "files": ["internal/domain/task.go"]
      },
      {
        "id": "plan-3",
        "description": "Format both files and run the declared Domain test command.",
        "files": ["internal/domain/task.go", "internal/domain/task_test.go"]
      }
    ]
  },
  "decisions": [
    {
      "id": "decision-real-task",
      "question": "Which repository task proves the first real coding path?",
      "resolution": "Use the Chora Domain validation task pinned in this contract.",
      "rationale": "It is a real, reviewable product change with a two-file boundary and deterministic tests."
    },
    {
      "id": "decision-primary-candidate",
      "question": "Which single Runtime and Sandbox combination enters the fresh Entry Probe?",
      "resolution": "Pi Coding Agent 0.84.1 over JSONL RPC in one disposable Colima-backed Docker container per Attempt.",
      "rationale": "Runtime, model, Sandbox, base images, configuration, and policy identities remain separate and immutable."
    }
  ],
  "risks": [
    {
      "id": "risk-model-compatibility",
      "severity": "high",
      "description": "The local model may fail Pi tool calling or the container may not reach the host endpoint.",
      "mitigation": "Keep provider/model identity separate and classify fresh Probe incompatibility as CANDIDATE_OR_ENV_FAILURE."
    },
    {
      "id": "risk-isolation",
      "severity": "critical",
      "description": "A host mount, process, or cleanup mistake could violate the Sandbox boundary.",
      "mitigation": "Fail closed on host access, process-tree death, identity, or cleanup uncertainty."
    }
  ],
