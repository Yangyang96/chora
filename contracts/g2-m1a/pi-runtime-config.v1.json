{
  "schema_version": "chora.pi-runtime-config.v1",
  "runtime": {
    "package": "@earendil-works/pi-coding-agent",
    "version": "0.84.1",
    "npm_integrity": "sha512-ncAqFrG+iybuPGOhMiZoEHkEzTpJgz3guYD32pD+M7ucc0WeHmauP6wa7qwP8V/KWvsZDVNa5XGsdZ7fkC7w7A==",
    "transport": [
      "pi",
      "--mode",
      "rpc",
      "--no-session",
      "--no-extensions",
      "--no-skills",
      "--no-prompt-templates",
      "--no-themes",
      "--no-context-files",
      "--no-approve",
      "--provider",
      "ollama",
      "--model",
      "minimax-m3:cloud"
    ]
  },
  "environment": {
    "PI_CODING_AGENT_DIR": "/run/chora/pi",
    "PI_OFFLINE": "1",
    "PI_SKIP_VERSION_CHECK": "1",
    "PI_TELEMETRY": "0"
  },
  "agent_directory": {
    "lifecycle": "new_empty_directory_per_attempt",
    "allowed_generated_files": ["models.json"],
    "inherit_host_state": false,
    "retain_after_attempt": false
  },
  "resources": {
    "third_party_packages": false,
    "extensions": false,
    "skills": false,
    "prompt_templates": false,
    "themes": false,
    "project_context_files": false,
    "undeclared_project_resources": false
  },
  "model_config": {
    "providers": {
      "ollama": {
        "baseUrl": "http://host.docker.internal:11434/v1",
        "api": "openai-completions",
        "apiKey": "ollama",
        "compat": {
          "supportsDeveloperRole": false,
          "supportsReasoningEffort": false
        },
        "models": [
          {
            "id": "minimax-m3:cloud",
            "name": "MiniMax M3",
            "reasoning": true,
            "contextWindow": 524288,
            "maxTokens": 8192
          }
        ]
      }
    }
  },
  "authentication": {
    "type": "host_ollama_cloud_session",
    "credential_environment_names": [],
    "dummy_provider_key_is_secret": false,
    "container_receives_cloud_credential": false,
    "host_daemon_owns_cloud_session": true
  },
  "pre_probe_unknowns": {
    "model_present_in_ollama": true,
    "model_digest": "sha256:8cd948b96f47afd232cef7d49faf65791d22bd9dbbef74add3b9355d9d75f765",
    "context_window": 524288,
    "provider_max_tokens": null,
    "configured_max_tokens": 8192,
    "container_endpoint_reachable": null,
    "pi_tool_calling_compatible": null,
    "resolution_gate": "G2-M2E Entry Probe"
  }
}
