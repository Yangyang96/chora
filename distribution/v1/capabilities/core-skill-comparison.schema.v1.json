{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chora.local/schemas/core-skill-comparison.v1.json",
  "title": "Chora conditional core Skill matched comparison",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "comparison_id", "baseline", "candidate"],
  "properties": {
    "schema_version": { "const": "chora.core-skill-comparison.v1" },
    "comparison_id": { "$ref": "#/$defs/id" },
    "baseline": {
      "allOf": [
        { "$ref": "#/$defs/run" },
        { "properties": { "variant": { "const": "no_skill" } } }
      ]
    },
    "candidate": {
      "allOf": [
        { "$ref": "#/$defs/run" },
        { "properties": { "variant": { "const": "candidate_skill" } } }
      ]
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "image_id": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256",
        "max_total_tokens",
        "max_tool_calls",
        "max_elapsed_millis",
        "max_cost_microunits"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "max_total_tokens": { "type": "integer", "minimum": 1 },
        "max_tool_calls": { "type": "integer", "minimum": 1 },
        "max_elapsed_millis": { "type": "integer", "minimum": 1 },
        "max_cost_microunits": { "type": "integer", "minimum": 1 }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "task_sha256",
        "snapshot_id",
        "snapshot_sha256",
        "engine_identity_sha256",
        "runtime_image_id",
        "model_provider_id",
        "model_id",
        "model_sha256",
        "limits",
        "tool_bundle_id",
        "tool_bundle_sha256",
        "candidate_id",
        "candidate_skill_sha256"
      ],
      "properties": {
        "task_id": { "$ref": "#/$defs/id" },
        "task_sha256": { "$ref": "#/$defs/sha256" },
        "snapshot_id": { "$ref": "#/$defs/id" },
        "snapshot_sha256": { "$ref": "#/$defs/sha256" },
        "engine_identity_sha256": { "$ref": "#/$defs/sha256" },
        "runtime_image_id": { "$ref": "#/$defs/image_id" },
        "model_provider_id": { "$ref": "#/$defs/id" },
        "model_id": { "$ref": "#/$defs/id" },
        "model_sha256": { "$ref": "#/$defs/sha256" },
        "limits": { "$ref": "#/$defs/limits" },
        "tool_bundle_id": { "$ref": "#/$defs/id" },
        "tool_bundle_sha256": { "$ref": "#/$defs/sha256" },
        "candidate_id": { "const": "chora.core-workflow.v1" },
        "candidate_skill_sha256": {
          "const": "a39a78290abaa14c42fb90875611967297db66b6b41dba6040676d7a486ac67c"
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "success",
        "manual_interventions",
        "tool_errors",
        "input_tokens",
        "output_tokens",
        "tool_calls",
        "elapsed_millis",
        "cost_microunits",
        "attempt_count",
        "hidden_retry_count",
        "framework_retry_count",
        "result_sha256",
        "evidence_sha256"
      ],
      "properties": {
        "success": { "type": "boolean" },
        "manual_interventions": { "type": "integer", "minimum": 0 },
        "tool_errors": { "type": "integer", "minimum": 0 },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "tool_calls": { "type": "integer", "minimum": 0 },
        "elapsed_millis": { "type": "integer", "minimum": 1 },
        "cost_microunits": { "type": "integer", "minimum": 0 },
        "attempt_count": { "const": 1 },
        "hidden_retry_count": { "const": 0 },
        "framework_retry_count": { "const": 0 },
        "result_sha256": { "$ref": "#/$defs/sha256" },
        "evidence_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variant", "real_task", "run_id", "attempt_id", "binding", "outcome"],
      "properties": {
        "variant": { "enum": ["no_skill", "candidate_skill"] },
        "real_task": { "const": true },
        "run_id": { "$ref": "#/$defs/id" },
        "attempt_id": { "$ref": "#/$defs/id" },
        "binding": { "$ref": "#/$defs/binding" },
        "outcome": { "$ref": "#/$defs/outcome" }
      }
    }
  }
}
